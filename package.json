{
  "name": "root",
  "packageManager": "pnpm@10.27.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm run build",
    "build": "pnpm --filter \"*\" run build",
    "eval:scrollshot": "pnpm --filter scrollshot-core run build && node scripts/scrollshot-eval.mjs",
    "smoke:scrollshot": "node scripts/scrollshot-electron-smoke.cjs",
    "check": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14"
  }
}
